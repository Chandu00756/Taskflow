# Environment: development | staging | production
# In anything but development, JWT_SECRET and SUPER_ADMIN_PASSWORD must be set.
ENVIRONMENT=development

# Server ports
GRPC_PORT=50051
HTTP_PORT=8080
ITSM_HTTP_PORT=8090

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskmanagement
DB_SSLMODE=disable
# Set to true to log every SQL statement (never in production)
DB_LOG_QUERIES=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication — use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=your-secret-key-change-in-production

# Platform super admin bootstrap (created on first start if missing)
SUPER_ADMIN_EMAIL=admin@taskflow.com
SUPER_ADMIN_PASSWORD=

# Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
# Trust X-Forwarded-For only behind a reverse proxy / load balancer
TRUST_PROXY_HEADERS=false
ITSM_SERVICE_URL=http://localhost:8090

# Service desk
# Base URL of the web app, used in email links
PUBLIC_URL=http://localhost:3000
MAX_UPLOAD_MB=15
WORKER_INTERVAL=60s
# Set to true on extra replicas if you want a dedicated worker; workers use a DB lock either way
DISABLE_WORKERS=false

# Outgoing email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend (build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=info
