# Production settings. setup-server.sh copies this to .env and fills in the
# secrets for you. Keep .env private (chmod 600) and never commit it.

# Public address of the app. Create a DNS "A" record for it that points at
# this server's public IP before starting the stack.
DOMAIN=taskflow.portalvii.com

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@portalvii.com

# Generated secrets (setup-server.sh replaces these with random values).
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# The platform super admin, created on first start. Use a strong password and
# change it after your first sign-in.
SUPER_ADMIN_EMAIL=admin@portalvii.com
SUPER_ADMIN_PASSWORD=change-me

# Outgoing email (optional). Without it, new users get a temporary password
# on screen instead of an invitation email. Free options: Brevo (300/day) or
# Resend (100/day). Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskFlow <support@portalvii.com>

# Limits
MAX_UPLOAD_MB=15
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
BACKUP_KEEP_DAYS=14

# Only change these when 80/443 are taken (e.g. for a local trial run).
HTTP_PORT=80
HTTPS_PORT=443
