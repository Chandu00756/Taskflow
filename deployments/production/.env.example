# Production settings. setup-server.sh copies this to .env and fills in the
# secrets for you. Keep .env private (chmod 600) and never commit it.

# Public address of the app. Create a DNS "A" record for it that points at
# this server's public IP before starting the stack.
DOMAIN=taskflow.portalvii.com

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@portalvii.com

# Generated secrets (setup-server.sh replaces these with random values).
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# The platform super admin, created on first start. Use a strong password and
# change it after your first sign-in.
SUPER_ADMIN_EMAIL=admin@portalvii.com
SUPER_ADMIN_PASSWORD=change-me

# Outgoing email: ticket notifications, welcome emails, email verification and
# password reset links. Leave SMTP_HOST empty to turn email off. Port 465 uses
# TLS; 587 uses STARTTLS. After changing these, run:
#   docker compose up -d user-service itsm-service
# then use Platform console -> Email -> "Send test email".
#
# A sending service built for app email is recommended: Zoho Mail mailboxes
# are for people and Zoho may block one that an app sends from.
#
# Zoho Mail mailbox on your domain (create an app password at
# accounts.zoho.com -> Security -> App passwords; SMTP_FROM must be that
# mailbox or one of its aliases):
#   SMTP_HOST=smtp.zoho.com   (paid Zoho Mail plans: smtppro.zoho.com)
#   SMTP_PORT=465
#   SMTP_USER=support@portalvii.com
#   SMTP_PASS=<the app password>
# Zoho ZeptoMail (built for app email):
#   SMTP_HOST=smtp.zeptomail.com  SMTP_PORT=587  SMTP_USER=emailapikey  SMTP_PASS=<SMTP password>
# Brevo (300 emails/day free):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<SMTP login>  SMTP_PASS=<SMTP key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskFlow <support@portalvii.com>
# At most this many emails per minute (0 = no limit). When the provider
# answers that it is limiting the account, sending pauses for 15 minutes
# (doubling up to 2 hours) instead of retrying; see Platform console -> Email.
SMTP_MAX_PER_MINUTE=30

# New sign-ups confirm their email before the first sign-in:
# auto (only when email is configured), required, or off.
EMAIL_VERIFICATION=auto

# Limits
MAX_UPLOAD_MB=15
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
BACKUP_KEEP_DAYS=14

# Only change these when 80/443 are taken (e.g. for a local trial run).
HTTP_PORT=80
HTTPS_PORT=443
