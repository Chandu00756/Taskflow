# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o itsm-service ./services/itsm

# Runtime stage
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata && adduser -D -u 10001 app

WORKDIR /app

COPY --from=builder /app/itsm-service .

USER app

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s CMD wget -qO- http://127.0.0.1:8090/health || exit 1

CMD ["./itsm-service"]
